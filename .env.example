# ==============================================================================
# Pérola Backend — Environment Variables Template
# ==============================================================================

# Server
PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5435
DB_NAME=perola_db
DB_USER=perola_user
DB_PASSWORD=perola_pass

# Security & JWT (Secret must be at least 256 bits / 32 bytes in hex or base64)
JWT_SECRET=
JWT_EXPIRATION_SECONDS=
JWT_REFRESH_EXPIRATION_SECONDS=

# Application Timezone
APP_TIMEZONE=
